{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jb-collections",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "jb-collections"
    }
  ],
  "vars": {
    "NEON_DATA_API_URL": "https://ep-wandering-scene-beu9tqyd.apirest.c-9.us-east-2.aws.neon.tech/neondb/rest/v1",
    "NEON_AUTH_BASE_URL": "https://ep-wandering-scene-beu9tqyd.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth"
  }
}
